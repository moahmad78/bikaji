# Database Configuration (Use PostgreSQL / Neon / Supabase for Vercel live DB)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Better Auth Configurations
BETTER_AUTH_SECRET="your_production_better_auth_secret_key"
BETTER_AUTH_URL="https://bikaji1.vercel.app"

# Application URL
NEXT_PUBLIC_APP_URL="https://bikaji1.vercel.app"
NEXT_PUBLIC_SOCKET_URL="https://your-socket-server.com"

# Cloudinary Storage Configurations
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://<your_api_key>:<your_api_secret>@fg3w4hig"

# ─── Socket Server ──────────────────────────────────────────────────────────
# Server-side (set in Vercel): POST /publish from Server Actions → socket server
SOCKET_SERVER_URL="https://bikaji-socket.onrender.com"

# Client-side (set in Vercel): browser clients connect to this URL
NEXT_PUBLIC_SOCKET_URL="https://bikaji-socket.onrender.com"
