generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Restaurant {
  id          String              @id @default(uuid())
  name        String
  logo        String?
  description String?
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  branches    Branch[]
  settings    RestaurantSetting[]
}

model Branch {
  id           String            @id @default(uuid())
  restaurantId String
  name         String
  address      String
  phone        String
  email        String?
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  activityLogs ActivityLog[]
  admins       Admin[]
  analytics    Analytics[]
  auditLogs    AuditLog[]
  banners      Banner[]
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories   Category[]
  coupons      Coupon[]
  menuItems    MenuItem[]
  offers       Offer[]
  openingHours OpeningHours[]
  orders       Order[]
  tables       RestaurantTable[]
  reviews      Review[]
  taxes        Tax[]
  waiters      Waiter[]

  @@index([restaurantId])
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  emailVerified Boolean        @default(false)
  image         String?
  role          Role           @default(CUSTOMER)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  activityLogs  ActivityLog[]
  adminProfile  Admin?
  auditLogs     AuditLog[]
  couponUsages  CouponUsage[]
  favorites     FavoriteItem[]
  feedbacks     Feedback[]
  notifications Notification[]
  orders        Order[]
  reviews       Review[]
  sessions      Session[]
  userRoles     UserRole[]
  waiterProfile Waiter?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model RoleModel {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         RoleModel  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role      RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Waiter {
  id             String        @id @default(uuid())
  userId         String        @unique
  branchId       String
  employeeId     String?       @unique
  isAvailable    Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTables WaiterTable[]

  @@index([branchId])
}

model Admin {
  id        String    @id @default(uuid())
  userId    String    @unique
  branchId  String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model RestaurantTable {
  id              String            @id @default(uuid())
  branchId        String
  number          Int
  capacity        Int               @default(4)
  status          TableStatus       @default(FREE)
  token           String            @default(dbgenerated("gen_random_uuid()"))
  floor           String?           @default("Ground Floor")
  section         String?           @default("Main Section")
  layoutX         Int               @default(100)
  layoutY         Int               @default(100)
  layoutShape     String            @default("SQUARE")
  layoutWidth     Int               @default(100)
  layoutHeight    Int               @default(100)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        CustomerSession[]
  orders          Order[]
  qrCode          QRCode?
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  waiters         WaiterTable[]

  @@unique([branchId, number])
  @@index([branchId])
}

model QRCode {
  id        String          @id @default(uuid())
  tableId   String          @unique
  codeUrl   String
  isActive  Boolean         @default(true)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  table     RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

model WaiterTable {
  waiterId  String
  tableId   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  table     RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiter    Waiter          @relation(fields: [waiterId], references: [id], onDelete: Cascade)

  @@id([waiterId, tableId])
}

model CustomerSession {
  id           String          @id @default(uuid())
  tableId      String
  token        String          @unique
  customerName String
  phone        String?
  isActive     Boolean         @default(true)
  expiresAt    DateTime
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  cart         Cart?
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([tableId])
}

model Category {
  id            String        @id @default(uuid())
  branchId      String
  name          String
  description   String?
  image         String?
  isActive      Boolean       @default(true)
  order         Int           @default(0)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items         MenuItem[]
  subCategories SubCategory[]

  @@unique([branchId, name])
  @@index([branchId])
}

model SubCategory {
  id          String     @id @default(uuid())
  categoryId  String
  name        String
  description String?
  isActive    Boolean    @default(true)
  order       Int        @default(0)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model MenuItem {
  id              String                  @id @default(uuid())
  branchId        String
  categoryId      String
  subCategoryId   String?
  name            String
  description     String
  price           Float
  offerPrice      Float?
  image           String
  isVeg           Boolean                 @default(true)
  isNonVeg        Boolean                 @default(false)
  isJain          Boolean                 @default(false)
  spicyLevel      SpicyLevel              @default(NONE)
  isBestseller    Boolean                 @default(false)
  isSpecial       Boolean                 @default(false)
  isFeatured      Boolean                 @default(false)
  isAvailable     Boolean                 @default(true)
  preparationTime Int                     @default(15)
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  cartItems       CartItem[]
  favoriteBy      FavoriteItem[]
  images          MenuImage[]
  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory     SubCategory?            @relation(fields: [subCategoryId], references: [id])
  addons          MenuItemAddon[]
  modifierGroups  MenuItemModifierGroup[]
  orderItems      OrderItem[]
  reviews         Review[]

  @@index([categoryId])
  @@index([branchId])
}

model MenuImage {
  id         String    @id @default(uuid())
  menuItemId String
  url        String
  isPrimary  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model ModifierGroup {
  id          String                  @id @default(uuid())
  name        String
  description String?
  minSelect   Int                     @default(0)
  maxSelect   Int                     @default(1)
  deletedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  menuItems   MenuItemModifierGroup[]
  modifiers   Modifier[]
}

model Modifier {
  id              String              @id @default(uuid())
  modifierGroupId String
  name            String
  price           Float               @default(0.0)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  cartItems       CartItemModifier[]
  modifierGroup   ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItems      OrderItemModifier[]

  @@index([modifierGroupId])
}

model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  createdAt       DateTime      @default(now())
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
}

model Addon {
  id         String           @id @default(uuid())
  name       String
  price      Float
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  cartItems  CartItemAddon[]
  menuItems  MenuItemAddon[]
  orderItems OrderItemAddon[]
}

model MenuItemAddon {
  menuItemId String
  addonId    String
  createdAt  DateTime @default(now())
  addon      Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([menuItemId, addonId])
}

model Cart {
  id        String          @id @default(uuid())
  sessionId String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  session   CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id           String             @id @default(uuid())
  cartId       String
  menuItemId   String
  quantity     Int
  specialNotes String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  cart         Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem     MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addons       CartItemAddon[]
  modifiers    CartItemModifier[]

  @@index([cartId])
}

model CartItemModifier {
  cartItemId String
  modifierId String
  createdAt  DateTime @default(now())
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifier   Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@id([cartItemId, modifierId])
}

model CartItemAddon {
  cartItemId String
  addonId    String
  createdAt  DateTime @default(now())
  addon      Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@id([cartItemId, addonId])
}

model Order {
  id               String           @id @default(uuid())
  branchId         String
  orderNumber      String
  tableId          String
  sessionId        String?
  customerId       String?
  customerName     String?
  status           OrderStatus      @default(PENDING)
  paymentStatus    PaymentStatus    @default(PENDING)
  paymentMethod    PaymentMethod    @default(UPI)
  totalAmount      Float
  gstAmount        Float
  serviceCharge    Float
  discountAmount   Float            @default(0.0)
  finalAmount      Float
  specialNotes     String?
  acceptedAt       DateTime?
  preparingAt      DateTime?
  readyAt          DateTime?
  servedAt         DateTime?
  completedAt      DateTime?
  expectedReadyAt  DateTime?
  delayMinutes     Int?
  delayReason      String?
  kitchenNotes     String?
  customerReply    String?
  waiterAcceptedAt DateTime?
  deliveredAt      DateTime?
  deliveryDuration Int?
  waiterId         String?
  waiterName       String?
  paidAt           DateTime?
  paidBy           String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  bills            Bill[]
  invoice          Invoice?
  kitchenTickets   KitchenTicket[]
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer         User?            @relation(fields: [customerId], references: [id])
  session          CustomerSession? @relation(fields: [sessionId], references: [id])
  table            RestaurantTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items            OrderItem[]
  payments         Payment[]

  @@unique([branchId, orderNumber])
  @@index([tableId])
  @@index([branchId])
  @@index([customerId])
}

model OrderItem {
  id           String              @id @default(uuid())
  orderId      String
  menuItemId   String
  name         String
  quantity     Int
  price        Float
  specialNotes String?
  deletedAt    DateTime?
  createdAt    DateTime            @default(now())
  menuItem     MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addons       OrderItemAddon[]
  modifiers    OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  orderItemId String
  modifierId  String
  name        String
  price       Float
  createdAt   DateTime  @default(now())
  modifier    Modifier  @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@id([orderItemId, modifierId])
}

model OrderItemAddon {
  orderItemId String
  addonId     String
  name        String
  price       Float
  createdAt   DateTime  @default(now())
  addon       Addon     @relation(fields: [addonId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@id([orderItemId, addonId])
}

model KitchenTicket {
  id           String       @id @default(uuid())
  orderId      String
  ticketNumber String
  queueId      String
  status       OrderStatus  @default(PENDING)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  queue        KitchenQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model KitchenQueue {
  id        String          @id @default(uuid())
  branchId  String
  name      String
  isActive  Boolean         @default(true)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tickets   KitchenTicket[]
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  amount          Float
  method          PaymentMethod
  status          PaymentStatus
  transactionId   String?       @unique
  gatewayResponse String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Tax {
  id        String    @id @default(uuid())
  branchId  String
  name      String
  rate      Float
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @db.Timestamp(6)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model Bill {
  id                 String     @id @default(uuid())
  orderId            String
  billNumber         String     @unique
  subtotal           Float
  discount           Float      @default(0.0)
  taxTotal           Float
  serviceChargeTotal Float
  finalAmount        Float
  isSettled          Boolean    @default(false)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items              BillItem[]
}

model BillItem {
  id         String    @id @default(uuid())
  billId     String
  name       String
  quantity   Int
  price      Float
  totalPrice Float
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bill       Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model Invoice {
  id            String    @id @default(uuid())
  orderId       String    @unique
  invoiceNumber String    @unique
  taxDetails    String?
  pdfUrl        String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String        @id @default(uuid())
  branchId        String
  code            String
  discountPercent Float         @default(0.0)
  discountType    DiscountType  @default(PERCENTAGE)
  discountValue   Float
  maxDiscount     Float?
  minOrderAmount  Float         @default(0.0)
  usageLimit      Int           @default(100)
  usageCount      Int           @default(0)
  isActive        Boolean       @default(true)
  expiresAt       DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  usages          CouponUsage[]

  @@unique([branchId, code])
  @@index([branchId])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String?
  orderId   String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([couponId])
}

model Offer {
  id              String    @id @default(uuid())
  branchId        String
  title           String
  description     String
  bannerImage     String?
  discountPercent Float?
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model Banner {
  id        String    @id @default(uuid())
  branchId  String
  imageUrl  String
  targetUrl String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model ServiceRequest {
  id        String          @id @default(uuid())
  tableId   String
  type      RequestType
  status    RequestStatus   @default(PENDING)
  notes     String?
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  table     RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  role      Role?
  title     String
  body      String
  type      String    @default("IN_APP")
  isRead    Boolean   @default(false)
  isPinned  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  platform  String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model RestaurantSetting {
  id                String     @id @default(uuid())
  restaurantId      String
  name              String     @default("Bikaji QR Smart Ordering")
  currency          String     @default("INR")
  gstRate           Float      @default(5.0)
  serviceChargeRate Float      @default(5.0)
  updatedAt         DateTime   @updatedAt
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model OpeningHours {
  id        String    @id @default(uuid())
  branchId  String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model Review {
  id         String    @id @default(uuid())
  branchId   String
  userId     String?
  menuItemId String
  rating     Int
  comment    String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id])

  @@index([menuItemId])
}

model Feedback {
  id                String    @id @default(uuid())
  userId            String?
  serviceRating     Int
  foodRating        Int
  cleanlinessRating Int
  comment           String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User?     @relation(fields: [userId], references: [id])
}

model FavoriteItem {
  id         String   @id @default(uuid())
  userId     String
  menuItemId String
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  branchId  String?
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
}

model AuditLog {
  id        String   @id @default(uuid())
  branchId  String?
  userId    String?
  tableName String
  recordId  String
  action    String
  oldValues String?
  newValues String?
  createdAt DateTime @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tableName, recordId])
}

model Analytics {
  id                 String   @id @default(uuid())
  branchId           String
  date               DateTime
  totalRevenue       Float
  totalOrders        Int
  averageOrderValue  Float
  popularItemId      String?
  tableOccupancyRate Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([branchId])
}

